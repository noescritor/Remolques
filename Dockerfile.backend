FROM denoland/deno:alpine-1.40.0

WORKDIR /app

# Copiar archivos manteniendo la estructura exacta
COPY src/app/types ./src/app/types
COPY supabase/functions/make-server-feea4382 ./supabase/functions/make-server-feea4382

WORKDIR /app/supabase/functions/make-server-feea4382

# Cache dependencies
RUN deno cache index.ts

EXPOSE 8000

# El código tiene Deno.serve(...) incorporado en el puerto 8000 por defecto
CMD ["run", "--allow-net", "--allow-env", "--allow-read", "index.ts"]
